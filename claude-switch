#!/bin/bash
# claude-switch — 공식 CLAUDE_CODE_OAUTH_TOKEN 기반 Claude 계정 선택 실행 래퍼
#
# 전역 Claude 인증 상태는 절대 변경하지 않는다. 프로필별로 보관한 1년 OAuth
# 토큰을 자식 프로세스의 CLAUDE_CODE_OAUTH_TOKEN 에만 주입한 뒤 claude 를 exec 한다.
#
# 저장소:
#   ~/.claude-switch/                        0700
#   ~/.claude-switch/config                  0600  key=value
#   ~/.claude-switch/tokens/<profile>.token  0600  토큰 원문 1줄
#   ~/.claude-switch/isolated/<profile>/     0700  --isolate 전용 CLAUDE_CONFIG_DIR

set -euo pipefail
umask 077

VERSION="2.0.0"

STORE_DIR="$HOME/.claude-switch"
CONFIG_FILE="$STORE_DIR/config"
TOKENS_DIR="$STORE_DIR/tokens"
ISOLATED_DIR="$STORE_DIR/isolated"
ACK_FILE="$STORE_DIR/.v1-acknowledged"

# v1 잔재 감지 전용. 내용을 읽지도, 쓰지도, 지우지도 않는다.
V1_DIR="$HOME/.claude-accounts"

CLAUDE_BIN="${CLAUDE_SWITCH_CLAUDE_BIN:-claude}"

# --------------------------------------------------------------------- 유틸

die() {
  local code="$1"
  shift
  printf '%s\n' "$@" >&2
  exit "$code"
}

usage() {
  cat <<'EOF'
claude-switch 2 — 프로필별 OAuth 토큰으로 Claude Code를 실행하는 래퍼

사용법:
  claude-switch run <profile> [-- <claude args...>]   프로필 토큰으로 claude 실행
  claude-switch <profile> [-- <claude args...>]       run 축약형
  claude-switch add <profile> [--stdin] [--force]     토큰 등록(비표시 입력)
  claude-switch list                                  프로필 목록과 지문
  claude-switch default <profile>                     기본 프로필 설정(인자 없으면 조회)
  claude-switch remove <profile>                      프로필 삭제
  claude-switch verify <profile>                      저장 상태 + 실제 OAuth 요청 검증
  claude-switch doctor                                저장소 진단
  claude-switch migrate-check [--acknowledge]         v1 잔재 확인과 승인

옵션:
  --isolate       해당 실행에만 프로필 전용 CLAUDE_CONFIG_DIR 사용
  -h, --help      이 도움말
  --version       버전 출력

토큰 등록:
  1. 별도 터미널에서 `claude setup-token` 실행 후 원하는 계정으로 승인
  2. `claude-switch add <profile>` 의 비표시 입력에 토큰 붙여넣기
  3. `claude-switch verify <profile>` 로 실제 OAuth 모델 요청 확인

프로필 이름: 영문, 숫자, 점(.), 밑줄(_), 하이픈(-). 하이픈으로 시작할 수 없음.
서브커맨드와 같은 이름의 프로필은 `claude-switch run <profile>` 로 실행하세요.
EOF
}

validate_profile_name() {
  local name="${1-}"
  case "$name" in
    "" | "." | "..")
      die 2 "❌ 잘못된 프로필 이름: ${name:-(빈 값)}" \
        "   허용 문자: 영문, 숫자, 점(.), 밑줄(_), 하이픈(-)"
      ;;
  esac
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die 2 "❌ 잘못된 프로필 이름: $name" \
      "   허용 문자: 영문, 숫자, 점(.), 밑줄(_), 하이픈(-)" \
      "   첫 글자는 영문 또는 숫자여야 합니다."
  fi
}

file_mode() {
  stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null || echo "unknown"
}

require_secure_directory() {
  local path="$1" label="$2" mode
  if [ -L "$path" ]; then
    die 1 "❌ ${label}가 심볼릭 링크입니다: $path" \
      "   보안상 따라가지 않습니다."
  fi
  if [ ! -d "$path" ]; then
    die 1 "❌ $label 없음: $path" \
      "   'claude-switch list' 로 프로필 상태를 확인하세요."
  fi
  mode="$(file_mode "$path")"
  if [ "$mode" != "700" ]; then
    die 1 "❌ $label 권한이 느슨합니다: $path ($mode)" \
      "   해결: chmod 700 $path"
  fi
}

clear_conflicting_auth_env() {
  unset ANTHROPIC_API_KEY
  unset ANTHROPIC_AUTH_TOKEN
  unset CLAUDE_CODE_USE_BEDROCK
  unset CLAUDE_CODE_USE_VERTEX
  unset CLAUDE_CODE_USE_FOUNDRY
  unset ANTHROPIC_BASE_URL
}

token_path() {
  printf '%s\n' "$TOKENS_DIR/$1.token"
}

ensure_store() {
  local d
  for d in "$STORE_DIR" "$TOKENS_DIR"; do
    if [ -L "$d" ]; then
      die 1 "❌ 심볼릭 링크는 저장소로 쓸 수 없음: $d"
    fi
    if [ ! -d "$d" ]; then
      mkdir -p "$d"
    fi
    chmod 700 "$d"
  done
}

# 토큰 원문을 그대로 흘리지 않고 복원 불가능한 지문만 만든다.
fingerprint() {
  set +x
  printf '%s' "$1" | shasum -a 256 | cut -c1-8
}

# --------------------------------------------------------------- config 파일
#
# config 는 절대 source 하지 않는다. key=value 만 엄격한 정규식으로 읽는다.

read_config_value() {
  local key="$1" line value=""
  [ -f "$CONFIG_FILE" ] || return 0
  require_secure_directory "$STORE_DIR" "저장소"
  [ ! -L "$CONFIG_FILE" ] || die 1 "❌ 심볼릭 링크 config 는 읽지 않습니다: $CONFIG_FILE"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "#"* | "") continue ;;
    esac
    if [[ "$line" =~ ^([A-Za-z_]+)=([A-Za-z0-9._-]*)$ ]] && [ "${BASH_REMATCH[1]}" = "$key" ]; then
      value="${BASH_REMATCH[2]}"
    fi
  done <"$CONFIG_FILE"
  printf '%s\n' "$value"
}

write_config_value() {
  local key="$1" value="$2" tmp line
  ensure_store
  [ ! -L "$CONFIG_FILE" ] || die 1 "❌ 심볼릭 링크 config 에는 쓰지 않습니다: $CONFIG_FILE"
  tmp="$CONFIG_FILE.tmp.$$"
  : >"$tmp"
  chmod 600 "$tmp"
  if [ -f "$CONFIG_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [[ "$line" =~ ^"$key"= ]]; then continue; fi
      printf '%s\n' "$line" >>"$tmp"
    done <"$CONFIG_FILE"
  fi
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

read_default() {
  read_config_value default
}

write_default() {
  write_config_value default "$1"
}

# -------------------------------------------------------------- file 백엔드

profile_exists() {
  local path
  require_secure_directory "$STORE_DIR" "저장소"
  require_secure_directory "$TOKENS_DIR" "토큰 디렉터리"
  path="$(token_path "$1")"
  [ -e "$path" ]
}

list_profile_names() {
  local f base
  if [ ! -e "$STORE_DIR" ] && [ ! -L "$STORE_DIR" ]; then return 0; fi
  require_secure_directory "$STORE_DIR" "저장소"
  if [ ! -e "$TOKENS_DIR" ] && [ ! -L "$TOKENS_DIR" ]; then return 0; fi
  require_secure_directory "$TOKENS_DIR" "토큰 디렉터리"
  shopt -s nullglob
  for f in "$TOKENS_DIR"/*.token; do
    base="${f##*/}"
    printf '%s\n' "${base%.token}"
  done
  shopt -u nullglob
}

# 토큰 파일의 첫 줄만 읽는다. 원문은 호출자 변수에만 담기고 로그에 남지 않는다.
read_token_raw() {
  set +x
  local path="$1" token=""
  IFS= read -r token <"$path" || true
  printf '%s' "${token%$'\r'}"
}

# 실행·검증 경로에서 쓰는 엄격한 읽기. 위반이면 즉시 중단한다.
read_token_checked() {
  set +x
  local name="$1" path mode token
  require_secure_directory "$STORE_DIR" "저장소"
  require_secure_directory "$TOKENS_DIR" "토큰 디렉터리"
  path="$(token_path "$name")"

  if [ -L "$path" ]; then
    die 1 "❌ 토큰이 심볼릭 링크입니다: $path" \
      "   보안상 따라가지 않습니다. 'claude-switch add $name --force' 로 다시 등록하세요."
  fi
  if [ ! -f "$path" ]; then
    die 1 "❌ 프로필 '$name' 없음" "   'claude-switch list' 로 확인하세요."
  fi
  mode="$(file_mode "$path")"
  if [ "$mode" != "600" ]; then
    die 1 "❌ 토큰 파일 권한이 느슨합니다: $path ($mode)" \
      "   해결: chmod 600 $path"
  fi
  token="$(read_token_raw "$path")"
  if [ -z "$token" ]; then
    die 1 "❌ 빈 토큰 파일: $path" \
      "   'claude setup-token' 후 'claude-switch add $name --force' 로 다시 등록하세요."
  fi
  if [[ ! "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
    die 1 "❌ 토큰 형식이 올바르지 않습니다: $path" \
      "   'claude-switch add $name --force' 로 다시 등록하세요."
  fi
  printf '%s' "$token"
}

# ------------------------------------------------------------- v1 잔재 가드
#
# v1 디렉터리는 존재만 확인한다. 내용을 읽지도, 쓰지도, 지우지도 않는다.

v1_residue_present() {
  [ -e "$V1_DIR" ] || [ -L "$V1_DIR" ]
}

v1_acknowledged() {
  [ -d "$STORE_DIR" ] && [ ! -L "$STORE_DIR" ] || return 1
  [ "$(file_mode "$STORE_DIR")" = "700" ] || return 1
  [ -f "$ACK_FILE" ] && [ ! -L "$ACK_FILE" ] || return 1
  [ "$(file_mode "$ACK_FILE")" = "600" ]
}

require_v1_acknowledged() {
  v1_residue_present || return 0
  v1_acknowledged && return 0
  die 2 "❌ v1 잔재가 감지되었습니다: $V1_DIR" \
    "   v2 는 v1 자격증명을 자동 변환하지 않습니다(수명과 발급 경로가 다릅니다)." \
    "   계정마다 'claude setup-token' 으로 새 토큰을 발급해 다시 등록해야 합니다." \
    "   자세한 절차: claude-switch migrate-check" \
    "   확인했으면:  claude-switch migrate-check --acknowledge"
}

# ------------------------------------------------------------------- 명령

cmd_add() {
  local name="" from_stdin=0 force=0 endopts=0 extra=0
  while [ "$#" -gt 0 ]; do
    if [ "$endopts" -eq 1 ]; then
      if [ -z "$name" ]; then name="$1"; else extra=1; fi
      shift
      continue
    fi
    case "$1" in
      --) endopts=1 ;;
      --stdin) from_stdin=1 ;;
      --force) force=1 ;;
      -*) die 2 "❌ 알 수 없는 옵션: $1" "   'claude-switch --help' 를 보세요." ;;
      *) if [ -z "$name" ]; then name="$1"; else extra=1; fi ;;
    esac
    shift
  done

  if [ "$extra" -eq 1 ]; then
    die 2 "❌ 토큰은 명령행 인자로 받지 않습니다." \
      "   대화형: claude-switch add <profile>" \
      "   자동화: <토큰 출력> | claude-switch add <profile> --stdin"
  fi
  validate_profile_name "$name"

  local path
  path="$(token_path "$name")"
  if [ -e "$path" ] && [ "$force" -ne 1 ]; then
    die 1 "❌ 프로필 '$name' 이 이미 있습니다." "   덮어쓰려면 --force 를 쓰세요."
  fi

  local token=""
  set +x
  if [ "$from_stdin" -eq 1 ]; then
    IFS= read -r token || true
  else
    if [ ! -t 0 ]; then
      die 2 "❌ 대화형 입력을 쓸 수 없습니다(터미널 아님)." \
        "   자동화에서는 --stdin 을 쓰세요."
    fi
    printf '%s' "setup-token 값 붙여넣기(화면에 표시되지 않음): " >&2
    IFS= read -r -s token || true
    printf '\n' >&2
  fi
  token="${token%$'\r'}"

  if [ -z "$token" ]; then
    die 1 "❌ 빈 토큰은 저장하지 않습니다."
  fi
  if [[ ! "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
    die 1 "❌ 토큰에 허용되지 않는 문자가 있습니다(공백·따옴표·줄바꿈 확인)."
  fi

  ensure_store
  if [ -L "$path" ]; then
    die 1 "❌ 심볼릭 링크에는 토큰을 쓰지 않습니다: $path"
  fi
  rm -f "$path"
  (
    set +x
    printf '%s\n' "$token" >"$path"
  )
  chmod 600 "$path"

  local fp
  fp="$(fingerprint "$token")"
  token=""
  echo "✅ 프로필 등록됨: $name (지문 fp:$fp)"

  if [ -z "$(read_default)" ]; then
    write_default "$name"
    echo "   기본 프로필로 설정됨: $name"
  fi
  echo "   확인: claude-switch verify $name"
  echo "   셸 스크롤백에 토큰이 남았는지 확인하고 지우세요."
}

cmd_list() {
  local names default_profile name width=0 fp mark suffix token path
  names="$(list_profile_names)"
  if [ -z "$names" ]; then
    echo "(프로필 없음 — 'claude-switch add <profile>' 먼저 실행)"
    return 0
  fi
  default_profile="$(read_default)"
  while IFS= read -r name; do
    [ "${#name}" -le "$width" ] || width="${#name}"
  done <<<"$names"

  while IFS= read -r name; do
    mark="  "
    suffix=""
    if [ "$name" = "$default_profile" ]; then
      mark="● "
      suffix="  (default)"
    fi
    path="$(token_path "$name")"
    if [ -L "$path" ]; then
      fp="⚠️  심볼릭 링크"
    elif [ ! -r "$path" ]; then
      fp="⚠️  읽을 수 없음"
    else
      token="$(read_token_raw "$path")"
      if [ -z "$token" ]; then
        fp="⚠️  빈 토큰"
      else
        fp="fp:$(fingerprint "$token")"
      fi
      token=""
    fi
    printf '%s%-*s  %s%s\n' "$mark" "$width" "$name" "$fp" "$suffix"
  done <<<"$names"
}

cmd_default() {
  local current
  if [ "$#" -eq 0 ]; then
    current="$(read_default)"
    if [ -z "$current" ]; then
      echo "기본 프로필 없음 — 'claude-switch default <profile>' 로 설정하세요."
    else
      echo "기본 프로필: $current"
    fi
    return 0
  fi
  [ "$#" -eq 1 ] || die 2 "❌ 사용법: claude-switch default [<profile>]"
  validate_profile_name "$1"
  profile_exists "$1" || die 1 "❌ 프로필 '$1' 없음" "   'claude-switch list' 로 확인하세요."
  write_default "$1"
  echo "✅ 기본 프로필: $1"
}

cmd_remove() {
  [ "$#" -eq 1 ] || die 2 "❌ 사용법: claude-switch remove <profile>"
  validate_profile_name "$1"
  local name="$1" path
  require_secure_directory "$STORE_DIR" "저장소"
  require_secure_directory "$TOKENS_DIR" "토큰 디렉터리"
  path="$(token_path "$name")"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    die 1 "❌ 프로필 '$name' 없음" "   'claude-switch list' 로 확인하세요."
  fi

  rm -f "$path"
  echo "✅ 프로필 삭제됨: $name"

  if [ "$(read_default)" = "$name" ]; then
    write_default ""
    echo "   기본 프로필이 해제되었습니다. 'claude-switch default <profile>' 로 다시 설정하세요."
  fi
  if [ -d "$ISOLATED_DIR/$name" ]; then
    echo "   격리 설정은 남겨둡니다: $ISOLATED_DIR/$name"
    echo "   필요 없으면 직접 삭제하세요."
  fi
  echo "   토큰을 더 쓰지 않으려면 Anthropic 콘솔에서 해당 토큰을 revoke 하세요."
}

# 토큰을 argv 가 아니라 자식 환경으로만 전달해 계정 상태를 조회한다.
probe_auth() {
  set +x
  (
    # 서브셸 범위로만 주입하는 것이 의도다(부모 환경을 오염시키지 않는다).
    # shellcheck disable=SC2030
    export CLAUDE_CODE_OAUTH_TOKEN="$1"
    clear_conflicting_auth_env
    exec "$CLAUDE_BIN" auth status --text
  ) 2>&1
}

# auth status는 잘못된 토큰도 존재만 하면 성공할 수 있어 실제 최소 요청으로 검증한다.
probe_live_model() {
  set +x
  (
    # shellcheck disable=SC2030
    export CLAUDE_CODE_OAUTH_TOKEN="$1"
    clear_conflicting_auth_env
    exec "$CLAUDE_BIN" -p \
      "Reply with exactly CLAUDE_SWITCH_VERIFY_OK and nothing else." \
      --output-format text
  ) 2>&1
}

cmd_verify() {
  local profile=""
  case "$#" in
    0)
      profile="$(read_default)"
      [ -n "$profile" ] || die 2 "❌ 검사할 프로필이 없습니다." \
        "   claude-switch verify <profile> 또는 기본 프로필을 설정하세요."
      ;;
    1) profile="$1" ;;
    *) die 2 "❌ 사용법: claude-switch verify [<profile>]" ;;
  esac
  validate_profile_name "$profile"

  local path token
  path="$(token_path "$profile")"
  token="$(read_token_checked "$profile")"

  echo "프로필    : $profile"
  echo "토큰 파일 : $path (권한 $(file_mode "$path"))"
  echo "지문      : fp:$(fingerprint "$token")"

  if ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
    echo "⚠️  claude 를 찾을 수 없어 계정 확인을 건너뜀: $CLAUDE_BIN"
    return 0
  fi

  local auth_out live_out safe_out rc=0
  auth_out="$(probe_auth "$token")" || rc=$?
  safe_out="${auth_out//$token/[redacted]}"
  if [ "$rc" -ne 0 ]; then
    token=""
    printf '%s\n' "$safe_out" >&2
    die 1 "❌ 인증 확인 실패: auth status 오류 (토큰 만료·취소 또는 네트워크 문제)" \
      "   재발급: claude setup-token → claude-switch add $profile --force"
  fi
  echo "인증 상태 :"
  printf '%s\n' "$safe_out" | sed 's/^/  /'

  rc=0
  live_out="$(probe_live_model "$token")" || rc=$?
  safe_out="${live_out//$token/[redacted]}"
  token=""
  if [ "$rc" -ne 0 ]; then
    [ -n "$safe_out" ] && printf '%s\n' "$safe_out" | sed 's/^/  /' >&2
    die 1 "❌ 실제 모델 호출 실패 — 토큰이 만료·취소됐거나 잘못 등록됐습니다." \
      "   재발급: claude setup-token → claude-switch add $profile --force"
  fi
  echo "실제 호출 :"
  echo "  ✅ OAuth 모델 요청 성공"
}

cmd_run() {
  local isolate=0 profile="" arg
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --isolate)
        isolate=1
        shift
        ;;
      --)
        shift
        break
        ;;
      -*) die 2 "❌ 알 수 없는 옵션: $1" "   'claude-switch --help' 를 보세요." ;;
      *)
        profile="$1"
        shift
        break
        ;;
    esac
  done
  if [ "${1-}" = "--" ]; then shift; fi

  if [ -z "$profile" ]; then
    profile="$(read_default)"
    [ -n "$profile" ] || die 2 "❌ 실행할 프로필이 없습니다." \
      "   claude-switch run <profile> 로 지정하거나 기본 프로필을 설정하세요:" \
      "   claude-switch default <profile>"
  fi
  validate_profile_name "$profile"

  for arg in "$@"; do
    if [ "$arg" = "--bare" ]; then
      die 2 "❌ --bare 는 OAuth 토큰을 읽지 않습니다." \
        "   --bare 의 Anthropic 인증은 ANTHROPIC_API_KEY 또는 apiKeyHelper 전용이라" \
        "   claude-switch 의 토큰 주입이 무시됩니다. --bare 없이 실행하세요."
    fi
  done

  local token
  token="$(read_token_checked "$profile")"

  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    echo "⚠️  ANTHROPIC_API_KEY 가 설정돼 있어 프로필 토큰보다 우선될 수 있습니다." >&2
  fi
  if [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    echo "⚠️  ANTHROPIC_AUTH_TOKEN 이 설정돼 있어 프로필 토큰보다 우선될 수 있습니다." >&2
  fi
  if [ -n "${CLAUDE_CODE_USE_BEDROCK:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_BEDROCK 가 설정돼 있어 Bedrock이 OAuth보다 우선됩니다." >&2
  fi
  if [ -n "${CLAUDE_CODE_USE_VERTEX:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_VERTEX 가 설정돼 있어 Vertex가 OAuth보다 우선됩니다." >&2
  fi
  if [ -n "${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_FOUNDRY 가 설정돼 있어 Foundry가 OAuth보다 우선됩니다." >&2
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    echo "⚠️  ANTHROPIC_BASE_URL 이 설정돼 있어 OAuth 토큰이 커스텀 엔드포인트로 전송될 수 있습니다." >&2
  fi
  clear_conflicting_auth_env

  command -v "$CLAUDE_BIN" >/dev/null 2>&1 ||
    die 127 "❌ claude 를 찾을 수 없습니다: $CLAUDE_BIN" \
      "   Claude Code 설치와 PATH 를 확인하세요."

  if [ "$isolate" -eq 1 ]; then
    local cdir="$ISOLATED_DIR/$profile"
    [ ! -L "$ISOLATED_DIR" ] || die 1 "❌ 심볼릭 링크는 격리 디렉터리로 쓸 수 없음: $ISOLATED_DIR"
    [ ! -L "$cdir" ] || die 1 "❌ 심볼릭 링크는 격리 디렉터리로 쓸 수 없음: $cdir"
    mkdir -p "$cdir"
    chmod 700 "$ISOLATED_DIR" "$cdir"
    export CLAUDE_CONFIG_DIR="$cdir"
    printf '▶ claude-switch: %s (격리 설정 %s)\n' "$profile" "$cdir" >&2
  else
    printf '▶ claude-switch: %s\n' "$profile" >&2
  fi

  set +x
  # shellcheck disable=SC2031
  export CLAUDE_CODE_OAUTH_TOKEN="$token"
  token=""
  exec "$CLAUDE_BIN" "$@"
}

cmd_migrate_check() {
  local ack=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --acknowledge) ack=1 ;;
      *) die 2 "❌ 알 수 없는 옵션: $1" "   사용법: claude-switch migrate-check [--acknowledge]" ;;
    esac
    shift
  done

  if ! v1_residue_present; then
    echo "v1 잔재 없음: $V1_DIR 이(가) 없습니다."
    echo "추가 조치가 필요하지 않습니다."
    return 0
  fi

  echo "v1 잔재 감지: $V1_DIR"
  echo "  v2 는 이 디렉터리를 읽지도, 쓰지도, 지우지도 않습니다."
  echo
  echo "자동 변환을 하지 않는 이유:"
  echo "  v1 은 access/refresh token 쌍이고, v2 는 'claude setup-token' 이 발급하는"
  echo "  1년 OAuth 토큰입니다. 수명과 발급 경로가 달라 안전한 변환이 불가능합니다."
  echo
  echo "프로필마다 수동 재등록:"
  echo "  1) claude setup-token          원하는 계정·조직으로 승인"
  echo "  2) claude-switch add <profile> 비표시 입력에 토큰 붙여넣기"
  echo "  3) claude-switch verify <profile>"
  echo

  if [ "$ack" -eq 1 ]; then
    ensure_store
    printf 'acknowledged\n' >"$ACK_FILE"
    chmod 600 "$ACK_FILE"
    echo "✅ 수동 재등록 원칙을 승인했습니다. v2 명령이 열립니다."
    echo "   v1 디렉터리 삭제 여부는 직접 결정하세요: $V1_DIR"
    return 0
  fi
  die 2 "위 내용을 확인했으면: claude-switch migrate-check --acknowledge"
}

cmd_doctor() {
  [ "$#" -eq 0 ] || die 2 "❌ 사용법: claude-switch doctor"
  local ok=1 mode names name path token default_profile

  echo "claude-switch doctor (v$VERSION)"
  echo "HOME        : $HOME"
  echo "저장소      : $STORE_DIR"
  echo "claude 경로 : $CLAUDE_BIN"
  echo

  if [ -L "$STORE_DIR" ]; then
    echo "❌ 저장소가 심볼릭 링크입니다: $STORE_DIR"
    ok=0
  elif [ ! -d "$STORE_DIR" ]; then
    echo "⚠️  저장소가 아직 없습니다. 'claude-switch add <profile>' 실행 시 생성됩니다."
  else
    mode="$(file_mode "$STORE_DIR")"
    if [ "$mode" = "700" ]; then
      echo "✅ 저장소 권한 700"
    else
      echo "❌ 저장소 권한이 $mode 입니다. 700 이어야 합니다."
      echo "   해결: chmod 700 $STORE_DIR"
      ok=0
    fi
    if [ -L "$TOKENS_DIR" ]; then
      echo "❌ 토큰 디렉터리가 심볼릭 링크입니다: $TOKENS_DIR"
      ok=0
    elif [ -d "$TOKENS_DIR" ]; then
      mode="$(file_mode "$TOKENS_DIR")"
      if [ "$mode" = "700" ]; then
        echo "✅ 토큰 디렉터리 권한 700"
      else
        echo "❌ 토큰 디렉터리 권한이 $mode 입니다. 700 이어야 합니다."
        echo "   해결: chmod 700 $TOKENS_DIR"
        ok=0
      fi
    fi
  fi

  if [ -L "$CONFIG_FILE" ]; then
    echo "❌ config 가 심볼릭 링크입니다: $CONFIG_FILE"
    ok=0
  elif [ -f "$CONFIG_FILE" ]; then
    mode="$(file_mode "$CONFIG_FILE")"
    if [ "$mode" = "600" ]; then
      echo "✅ config 권한 600"
    else
      echo "❌ config 권한이 $mode 입니다. 600 이어야 합니다."
      echo "   해결: chmod 600 $CONFIG_FILE"
      ok=0
    fi
  fi

  echo
  echo "프로필:"
  names="$(list_profile_names)"
  if [ -z "$names" ]; then
    echo "  (프로필 없음 — 'claude-switch add <profile>' 먼저 실행)"
  else
    while IFS= read -r name; do
      path="$(token_path "$name")"
      if [ -L "$path" ]; then
        echo "  ❌ $name: 토큰이 심볼릭 링크입니다 ($path)"
        ok=0
        continue
      fi
      mode="$(file_mode "$path")"
      if [ "$mode" != "600" ]; then
        echo "  ❌ $name: 토큰 파일 권한이 $mode 입니다."
        echo "     해결: chmod 600 $path"
        ok=0
        continue
      fi
      token="$(read_token_raw "$path")"
      if [ -z "$token" ]; then
        echo "  ❌ $name: 빈 토큰 파일입니다 ($path)"
        ok=0
      elif [[ ! "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
        echo "  ❌ $name: 토큰 형식이 올바르지 않습니다 ($path)"
        ok=0
      else
        echo "  ✅ $name: fp:$(fingerprint "$token") 권한 600"
      fi
      token=""
    done <<<"$names"
  fi

  echo
  if [ -L "$CONFIG_FILE" ]; then
    default_profile=""
  else
    default_profile="$(read_default)"
  fi
  if [ -z "$default_profile" ]; then
    echo "⚠️  기본 프로필 없음 — 'claude-switch default <profile>' 로 설정하세요."
  elif profile_exists "$default_profile"; then
    echo "✅ 기본 프로필: $default_profile"
  else
    echo "❌ 기본 프로필 '$default_profile' 의 토큰이 없습니다."
    echo "   해결: claude-switch default <profile>"
    ok=0
  fi

  if command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
    echo "✅ claude 실행 파일 확인: $(command -v "$CLAUDE_BIN")"
  else
    echo "❌ claude 를 찾을 수 없습니다: $CLAUDE_BIN"
    echo "   Claude Code 설치와 PATH 를 확인하세요."
    ok=0
  fi

  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    echo "⚠️  ANTHROPIC_API_KEY 가 설정돼 있어 프로필 토큰보다 우선될 수 있습니다."
  fi
  if [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    echo "⚠️  ANTHROPIC_AUTH_TOKEN 이 설정돼 있어 프로필 토큰보다 우선될 수 있습니다."
  fi
  if [ -n "${CLAUDE_CODE_USE_BEDROCK:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_BEDROCK 가 설정돼 있어 Bedrock이 OAuth보다 우선됩니다."
  fi
  if [ -n "${CLAUDE_CODE_USE_VERTEX:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_VERTEX 가 설정돼 있어 Vertex가 OAuth보다 우선됩니다."
  fi
  if [ -n "${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then
    echo "⚠️  CLAUDE_CODE_USE_FOUNDRY 가 설정돼 있어 Foundry가 OAuth보다 우선됩니다."
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    echo "⚠️  ANTHROPIC_BASE_URL 이 설정돼 있어 OAuth 토큰이 커스텀 엔드포인트로 전송될 수 있습니다."
  fi
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "⚠️  CLAUDE_CODE_OAUTH_TOKEN 이 이미 셸에 설정돼 있습니다(claude-switch 밖에서 설정됨)."
  fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    echo "⚠️  CLAUDE_CONFIG_DIR 이 이미 설정돼 있습니다: $CLAUDE_CONFIG_DIR"
  fi

  echo
  if v1_residue_present; then
    if v1_acknowledged; then
      echo "⚠️  v1 잔재가 남아 있습니다(승인됨): $V1_DIR"
      echo "   v2 는 이 디렉터리를 건드리지 않습니다. 삭제는 직접 결정하세요."
    else
      echo "❌ v1 잔재가 있고 아직 승인되지 않았습니다: $V1_DIR"
      echo "   해결: claude-switch migrate-check --acknowledge"
      ok=0
    fi
  else
    echo "✅ v1 잔재 없음"
  fi

  if [ "$ok" -eq 1 ]; then
    echo
    echo "✅ doctor OK"
    return 0
  fi
  return 1
}

# ------------------------------------------------------------------ dispatch

main() {
  # v1 잔재 가드. 진단·안내·도움말은 언제나 열어 둔다.
  case "${1:-}" in
    "" | -h | --help | help | --version | -V | doctor | migrate-check | capture) ;;
    *) require_v1_acknowledged ;;
  esac

  case "${1:-}" in
    -h | --help | help)
      usage
      return 0
      ;;
    --version | -V)
      echo "claude-switch $VERSION"
      return 0
      ;;
    "")
      usage >&2
      return 2
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    list | -l | --list)
      shift
      [ "$#" -eq 0 ] || die 2 "❌ 사용법: claude-switch list"
      cmd_list
      ;;
    default)
      shift
      cmd_default "$@"
      ;;
    remove | rm)
      shift
      cmd_remove "$@"
      ;;
    verify)
      shift
      cmd_verify "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    migrate-check)
      shift
      cmd_migrate_check "$@"
      ;;
    capture)
      die 2 "❌ v1 전용 명령입니다: capture" \
        "   v2 는 Keychain 이나 v1 파일에서 토큰을 가져오지 않습니다." \
        "   'claude setup-token' 으로 새 토큰을 발급한 뒤" \
        "   'claude-switch add <profile>' 로 등록하세요."
      ;;
    --isolate)
      cmd_run "$@"
      ;;
    -*)
      die 2 "❌ 알 수 없는 옵션: $1" "   'claude-switch --help' 를 보세요."
      ;;
    *)
      cmd_run "$@"
      ;;
  esac
}

main "$@"
