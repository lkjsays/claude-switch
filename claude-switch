#!/bin/bash
# claude-switch — Claude Code OAuth account switcher (keychain-free)
#
# Storage:
#   ~/.claude-accounts/<name>.json          raw OAuth credentials, 0600
#   ~/.claude-accounts/<name>.config.json   per-account snapshot of ~/.claude.json
#   ~/.claude-accounts/.current             active profile name
#
# Active state:
#   ~/.claude/.credentials.json ← copy of ~/.claude-accounts/<active>.json
#   ~/.claude.json              ← copy of ~/.claude-accounts/<active>.config.json
#
# Note: ~/.claude/.credentials.json is intentionally a regular file, not a
# symlink. Claude Code may refresh tokens using atomic rename, which replaces
# symlinks instead of following them. We sync the live file back before switches.
#
# Usage:
#   claude-switch                          현재 활성 프로필 표시
#   claude-switch --list                   전체 프로필 + 활성 표시
#   claude-switch <name>                   즉시 전환 (현재 ~/.claude.json은 write-back, 새 프로필 .config.json 로드)
#   claude-switch add <name>               `claude /login` 직후 Keychain → 파일 + Keychain 삭제
#   claude-switch add <name> <path>        외부 credentials.json 파일에서 등록
#   claude-switch remove <name>
#   claude-switch doctor                  현재 상태 진단
#
# 주의: 현재 실행 중인 claude 세션엔 영향 없음. 다음 호출부터 새 계정 사용.

set -euo pipefail

ACCOUNTS_DIR="$HOME/.claude-accounts"
CURRENT_FILE="$ACCOUNTS_DIR/.current"
ACTIVE_CREDENTIALS="$HOME/.claude/.credentials.json"
LIVE_CONFIG="$HOME/.claude.json"

mkdir -p "$ACCOUNTS_DIR"
chmod 700 "$ACCOUNTS_DIR"

validate_profile_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "❌ 잘못된 프로필 이름: $name" >&2
    echo "   허용 문자: 영문, 숫자, 점(.), 밑줄(_), 하이픈(-)" >&2
    exit 2
  fi
}

validate_credentials_file() {
  local path="$1"
  python3 - "$path" <<'PYEOF'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except Exception as e:
    print(f"❌ credentials JSON 파싱 실패: {e}", file=sys.stderr)
    sys.exit(1)
oauth = data.get("claudeAiOauth", data)
missing = [k for k in ("accessToken", "refreshToken") if not oauth.get(k)]
if missing:
    print("❌ credentials 필수 필드 없음: " + ", ".join(missing), file=sys.stderr)
    sys.exit(1)
PYEOF
}

delete_keychain_credentials() {
  # Claude Code가 Keychain 값을 우선 읽으면 파일 기반 전환이 무시될 수 있어
  # 전환/캡처 시마다 남아있는 Keychain credentials를 best-effort로 제거한다.
  command -v security >/dev/null 2>&1 || return 0
  security delete-generic-password -s "Claude Code-credentials" >/dev/null 2>&1 || true
}

list_profiles() {
  local current=""
  [ -f "$CURRENT_FILE" ] && current=$(cat "$CURRENT_FILE")
  local found=0
  for f in "$ACCOUNTS_DIR"/*.json; do
    [ -f "$f" ] || continue
    local base
    base=$(basename "$f" .json)
    # skip .config.json files
    case "$base" in *.config) continue ;; esac
    found=1
    if [ "$base" = "$current" ]; then
      echo "● $base (active)"
    else
      echo "  $base"
    fi
  done
  [ $found -eq 0 ] && echo "(프로필 없음 — 'claude-switch add <name>' 먼저 실행)"
}

show_current() {
  if [ -f "$CURRENT_FILE" ]; then
    local current
    current=$(cat "$CURRENT_FILE")
    echo "현재 프로필: $current"
    if [ -L "$ACTIVE_CREDENTIALS" ]; then
      echo "credentials : $ACTIVE_CREDENTIALS → $(readlink "$ACTIVE_CREDENTIALS") (legacy symlink)"
      echo "              다음 전환 시 regular file로 변환됩니다."
    elif [ -f "$ACTIVE_CREDENTIALS" ]; then
      echo "credentials : $ACTIVE_CREDENTIALS ($(wc -c <"$ACTIVE_CREDENTIALS" | tr -d ' ') bytes)"
    else
      echo "⚠️  $ACTIVE_CREDENTIALS 없음"
    fi
    if [ -f "$LIVE_CONFIG" ]; then
      echo "config      : $LIVE_CONFIG ($(wc -c <"$LIVE_CONFIG" | tr -d ' ') bytes)"
    fi
  else
    echo "활성 프로필 없음"
  fi
}

# Write current ~/.claude/.credentials.json back to the active profile.
# This preserves refreshed tokens written by Claude Code before switching away.
writeback_active_credentials() {
  if [ ! -f "$CURRENT_FILE" ]; then return 0; fi
  if [ ! -e "$ACTIVE_CREDENTIALS" ]; then return 0; fi
  local current dst
  current=$(cat "$CURRENT_FILE")
  dst="$ACCOUNTS_DIR/$current.json"
  if [ -f "$dst" ] && [ "$ACTIVE_CREDENTIALS" -ef "$dst" ]; then
    return 0
  fi
  if validate_credentials_file "$ACTIVE_CREDENTIALS"; then
    cp "$ACTIVE_CREDENTIALS" "$dst"
    chmod 600 "$dst"
    echo "✅ Claude가 갱신한 credentials를 $current 프로필에 저장함"
  else
    echo "⚠️  현재 credentials가 유효하지 않아 프로필에 덮어쓰지 않음: $ACTIVE_CREDENTIALS" >&2
  fi
}

# Write current ~/.claude.json back to the active profile's snapshot.
# Called before switching away from the active profile.
writeback_active_config() {
  if [ ! -f "$CURRENT_FILE" ]; then return 0; fi
  if [ ! -f "$LIVE_CONFIG" ]; then return 0; fi
  local current
  current=$(cat "$CURRENT_FILE")
  cp "$LIVE_CONFIG" "$ACCOUNTS_DIR/$current.config.json"
  chmod 600 "$ACCOUNTS_DIR/$current.config.json"
}

writeback_active() {
  writeback_active_credentials
  writeback_active_config
}
switch_to() {
  local name="$1"
  validate_profile_name "$name"
  local cred_src="$ACCOUNTS_DIR/$name.json"
  local cfg_src="$ACCOUNTS_DIR/$name.config.json"
  if [ ! -f "$cred_src" ]; then
    echo "❌ 프로필 '$name' 없음. 사용 가능:" >&2
    list_profiles >&2
    exit 1
  fi
  validate_credentials_file "$cred_src"
  # 1. write back current state, including refreshed live credentials
  writeback_active
  # 2. make sure Claude Code cannot prefer stale Keychain credentials
  delete_keychain_credentials
  # 3. copy credentials into the live path as a regular file
  mkdir -p "$(dirname "$ACTIVE_CREDENTIALS")"
  rm -f "$ACTIVE_CREDENTIALS"
  cp "$cred_src" "$ACTIVE_CREDENTIALS"
  chmod 600 "$ACTIVE_CREDENTIALS"
  # 4. load new profile's .claude.json snapshot (if exists)
  if [ -f "$cfg_src" ]; then
    cp "$cfg_src" "$LIVE_CONFIG"
    chmod 600 "$LIVE_CONFIG"
  else
    echo "⚠️  $name.config.json 없음. ~/.claude.json은 그대로 유지." >&2
    echo "    이번 claude 실행 후 자동 캡처됩니다."
  fi
  # 5. mark active
  echo "$name" > "$CURRENT_FILE"
  # 6. fresh-fetch oauthAccount from token to prevent stale/wrong data
  refresh_oauth_account "$name"
  # 7. remove Keychain again in case any helper recreated it during refresh path
  delete_keychain_credentials
  echo "✅ 전환됨: $name"
}

# Fetch oauthAccount from Anthropic OAuth profile endpoint using the active
# token, and overwrite ~/.claude.json's oauthAccount field. Prevents stale
# write-back contamination. Silent-fail (network down, etc).
refresh_oauth_account() {
  local name="$1"
  local cred="$ACCOUNTS_DIR/$name.json"
  [ -f "$cred" ] || return 0
  [ -f "$LIVE_CONFIG" ] || return 0
  python3 - "$cred" "$LIVE_CONFIG" <<'PYEOF' 2>/dev/null || true
import json, sys, urllib.request, os
cred_path, live_path = sys.argv[1], sys.argv[2]
with open(cred_path) as f:
    cred = json.load(f)
token = cred.get("claudeAiOauth", cred).get("accessToken")
if not token:
    sys.exit(0)
req = urllib.request.Request(
    "https://api.anthropic.com/api/oauth/profile",
    headers={"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"},
)
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        api = json.loads(r.read())
except Exception:
    sys.exit(0)
acct, org = api["account"], api["organization"]
with open(live_path) as f:
    snap = json.load(f)
oa = dict(snap.get("oauthAccount") or {})
oa.update({
    "accountUuid": acct["uuid"],
    "emailAddress": acct["email"],
    "organizationUuid": org["uuid"],
    "hasExtraUsageEnabled": org.get("has_extra_usage_enabled", False),
    "billingType": org.get("billing_type"),
    "accountCreatedAt": acct.get("created_at"),
    "subscriptionCreatedAt": org.get("subscription_created_at"),
    "ccOnboardingFlags": org.get("cc_onboarding_flags", {}),
    "claudeCodeTrialEndsAt": org.get("claude_code_trial_ends_at"),
    "claudeCodeTrialDurationDays": org.get("claude_code_trial_duration_days"),
    "seatTier": org.get("seat_tier"),
    "displayName": acct.get("display_name"),
    "organizationName": org["name"],
    "organizationType": org.get("organization_type"),
    "organizationRateLimitTier": org.get("rate_limit_tier"),
})
snap["oauthAccount"] = oa
tmp = live_path + ".tmp"
with open(tmp, "w") as f:
    json.dump(snap, f, indent=2, ensure_ascii=False)
os.chmod(tmp, 0o600)
os.replace(tmp, live_path)
# also persist back to the profile snapshot so write-back never re-corrupts it
cfg_path = os.path.expanduser(f"~/.claude-accounts/{os.path.basename(cred_path)[:-5]}.config.json")
with open(cfg_path, "w") as f:
    json.dump(snap, f, indent=2, ensure_ascii=False)
os.chmod(cfg_path, 0o600)
PYEOF
}

doctor() {
  local ok=1
  echo "claude-switch doctor"
  echo "HOME         : $HOME"
  echo "accounts dir : $ACCOUNTS_DIR"
  if [ -d "$ACCOUNTS_DIR" ]; then
    echo "accounts perm: $(stat -f %Lp "$ACCOUNTS_DIR" 2>/dev/null || stat -c %a "$ACCOUNTS_DIR" 2>/dev/null || echo unknown)"
  else
    echo "❌ accounts dir 없음"
    ok=0
  fi

  local current=""
  if [ -f "$CURRENT_FILE" ]; then
    current=$(cat "$CURRENT_FILE")
    echo "current      : $current"
  else
    echo "⚠️  current 파일 없음: $CURRENT_FILE"
    ok=0
  fi

  if [ -L "$ACTIVE_CREDENTIALS" ]; then
    local target
    target=$(readlink "$ACTIVE_CREDENTIALS")
    echo "⚠️  credentials  : $ACTIVE_CREDENTIALS → $target (legacy symlink)"
    echo "   해결: claude-switch <profile> 실행 시 regular file로 변환됨"
    if [ -f "$target" ] && validate_credentials_file "$target"; then
      echo "credentials  : symlink target JSON/accessToken/refreshToken OK"
    else
      ok=0
    fi
  elif [ -f "$ACTIVE_CREDENTIALS" ]; then
    echo "credentials  : $ACTIVE_CREDENTIALS (regular file)"
    if validate_credentials_file "$ACTIVE_CREDENTIALS"; then
      echo "credentials  : JSON/accessToken/refreshToken OK"
    else
      ok=0
    fi
  else
    echo "❌ credentials 파일 없음: $ACTIVE_CREDENTIALS"
    ok=0
  fi

  if command -v security >/dev/null 2>&1; then
    if security find-generic-password -s "Claude Code-credentials" -w >/dev/null 2>&1; then
      echo "❌ Keychain에 Claude Code-credentials가 남아있음"
      echo "   해결: claude-switch <profile> 또는 security delete-generic-password -s 'Claude Code-credentials'"
      ok=0
    else
      echo "keychain     : Claude Code-credentials 없음 OK"
    fi
  else
    echo "keychain     : security 명령 없음 (macOS가 아니면 정상)"
  fi

  if [ -f "$LIVE_CONFIG" ]; then
    if python3 -m json.tool "$LIVE_CONFIG" >/dev/null 2>&1; then
      echo "config       : $LIVE_CONFIG JSON OK"
    else
      echo "❌ config JSON 파싱 실패: $LIVE_CONFIG"
      ok=0
    fi
  else
    echo "⚠️  config 없음: $LIVE_CONFIG"
  fi

  [ "$ok" -eq 1 ] && echo "✅ doctor OK" || exit 1
}

add_from_file() {
  local name="$1"
  local src="$2"
  validate_profile_name "$name"
  if [ ! -f "$src" ]; then
    echo "❌ 파일 없음: $src" >&2
    exit 1
  fi
  validate_credentials_file "$src"
  cp "$src" "$ACCOUNTS_DIR/$name.json"
  chmod 600 "$ACCOUNTS_DIR/$name.json"
  if [ -f "$LIVE_CONFIG" ] && [ ! -f "$ACCOUNTS_DIR/$name.config.json" ]; then
    cp "$LIVE_CONFIG" "$ACCOUNTS_DIR/$name.config.json"
    chmod 600 "$ACCOUNTS_DIR/$name.config.json"
    echo "✅ 현재 .claude.json 스냅샷 저장됨"
  fi
  echo "✅ 프로필 추가됨: $name"
}

capture_profile() {
  local name="$1"
  validate_profile_name "$name"
  echo "Keychain에서 'Claude Code-credentials' 읽는 중..."
  local raw
  if ! raw=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null); then
    echo "❌ Keychain 항목 없음. 'claude /login' 먼저 실행했는지 확인." >&2
    exit 1
  fi
  echo "$raw" > "$ACCOUNTS_DIR/$name.json"
  chmod 600 "$ACCOUNTS_DIR/$name.json"
  validate_credentials_file "$ACCOUNTS_DIR/$name.json"
  # 현재 ~/.claude.json도 함께 캡처 (방금 claude /login한 직후라 이 프로필 상태)
  if [ -f "$LIVE_CONFIG" ]; then
    cp "$LIVE_CONFIG" "$ACCOUNTS_DIR/$name.config.json"
    chmod 600 "$ACCOUNTS_DIR/$name.config.json"
    echo "✅ .claude.json 스냅샷 저장됨"
  fi
  delete_keychain_credentials
  echo "✅ Keychain 항목 삭제됨(없어도 정상)"
  # 활성 링크가 깨졌으면 이 프로필로 자동 활성화
  if [ ! -L "$ACTIVE_CREDENTIALS" ]; then
    mkdir -p "$(dirname "$ACTIVE_CREDENTIALS")"
    rm -f "$ACTIVE_CREDENTIALS"
    ln -s "$ACCOUNTS_DIR/$name.json" "$ACTIVE_CREDENTIALS"
    echo "$name" > "$CURRENT_FILE"
    echo "✅ 활성 링크 복구됨 → $name"
  fi
  echo "✅ 프로필 캡처됨: $name"
}

remove_profile() {
  local name="$1"
  validate_profile_name "$name"
  if [ ! -f "$ACCOUNTS_DIR/$name.json" ]; then
    echo "❌ 프로필 '$name' 없음" >&2
    exit 1
  fi
  local current=""
  [ -f "$CURRENT_FILE" ] && current=$(cat "$CURRENT_FILE")
  if [ "$name" = "$current" ]; then
    echo "❌ 활성 프로필은 삭제 불가. 먼저 다른 프로필로 전환할 것." >&2
    exit 1
  fi
  rm -f "$ACCOUNTS_DIR/$name.json" "$ACCOUNTS_DIR/$name.config.json"
  echo "✅ 프로필 삭제됨: $name"
}

case "${1:-}" in
  "")             show_current ;;
  -l|--list|list) list_profiles ;;
  -h|--help|help)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  doctor)
    doctor
    ;;
  add)
    case $# in
      2) capture_profile "$2" ;;
      3) add_from_file "$2" "$3" ;;
      *) echo "Usage: claude-switch add <name> [path-to-credentials.json]" >&2; exit 2 ;;
    esac
    ;;
  capture)
    [ $# -eq 2 ] || { echo "Usage: claude-switch capture <name>" >&2; exit 2; }
    capture_profile "$2"
    ;;
  remove|rm)
    [ $# -eq 2 ] || { echo "Usage: claude-switch remove <name>" >&2; exit 2; }
    remove_profile "$2"
    ;;
  *)
    switch_to "$1"
    ;;
esac
